<Window
    x:Class="PanelControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelos="using:PanelControl.Modelos"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Sistema de Deteccion de Intrusiones IoT" FontSize="24" FontWeight="Bold"/>
            <Ellipse Width="14" Height="14" Fill="{x:Bind ModeloVista.ColorEstadoConexion, Mode=OneWay}" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ModeloVista.TextoEstadoConexion, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Eventos procesados" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ModeloVista.TotalEventos, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Alertas generadas" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ModeloVista.TotalAlertas, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Tiempo resp. promedio" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ModeloVista.TiempoRespuestaPromedioTexto, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Ultima alerta" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ModeloVista.UltimaAlertaTexto, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ToggleSwitch Grid.Row="0" HorizontalAlignment="Left" OnContent="Mostrando solo amenazas" OffContent="Mostrando todos los eventos" IsOn="{x:Bind ModeloVista.SoloAmenazas, Mode=TwoWay}"/>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ModeloVista.EventosVisibles, Mode=OneWay}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hora" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="IP origen" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="IP destino" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Puerto" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Clasificador" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Etiqueta" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="Confianza" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="7" Text="Tiempo (ms)" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:RegistroEvento">
                        <Grid Padding="8,6" ColumnSpacing="8" Background="{x:Bind ColorFondo}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind HoraTexto}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind IpOrigen}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind IpDestino}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind PuertoDestino}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Clasificador}"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Etiqueta}"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind ConfianzaTexto}"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind TiempoRespuestaTexto}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>