  "cards": [
    {
      "dot": "cyan",
      "title": "Capture Engine — Data Flow",
      "items": [
        "Input: raw Ethernet frames via libpcap on br0",
        "BPF: \"ip and not port 9999\"",
        "Parse: Ethernet → IP → TCP/UDP → DNS",
        "Output: EventoRed struct (27 fields)",
        "Batch: 25 events or 1s flush",
        "Transport: TCP socket → JSON newline-delimited",
        "Reconnect: 3 retries · 250ms delay · 5000 event buffer"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inference Server — Detection Pipeline",
      "items": [
        "Input: TCP :9999 · newline-delimited JSON",
        "Decode: json::parse → vector<EventoRed>",
        "Detector 1: Port Scan (>15 ports / 5s)",
        "Detector 2: Brute Force (>8 SYN / credential ports / 300s)",
        "Detector 3: DGA (>6 suspicious domains / 30s)",
        "Detector 4: Beaconing (CV ≤ 0.15 · 10-180s · 10+ reps)",
        "Detector 5: Signatures (IoT exploit ports + DoS >300 pps)",
        "Detector 6: ML XGBoost (prob > 0.90 · ≥30 pkts · ≥150 pps)",
        "First match wins · 60s cooldown per flow"
      ]
    },
    {
      "dot": "violet",
      "title": "JSON Transport Format",
      "items": [
        "Fields: ip_origen, ip_destino, puerto_origen, puerto_destino",
        "Protocol, duration, packets/bytes per direction",
        "Transfer rate, TTL, payload size, interval, fluctuation",
        "Flow counters: orig_pkts, resp_pkts, ip_bytes",
        "Flags: es_syn (bool), consulta_dns (string)",
        "Batch: JSON array, newline-terminated",
        "Server response: none (fire-and-forget)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Security",
      "items": [
        "IoT network: untrusted — captured via bridge",
        "TCP channel: NO TLS · NO auth · plaintext JSON",
        "sistema-captura requires root (sudo) for libpcap",
        "JSON parsing: try/catch + field defaults",
        "CSV: mutex-protected · header mismatch → reset",
        "Panel Control: read-only file access",
        "ML model: single load at startup"
      ]
    },
    {
      "dot": "amber",
      "title": "External Dependencies",
      "items": [
        "libpcap — raw packet capture (apt)",
        "nlohmann/json — vendored header-only",
        "Python 3.10+ — pandas, xgboost, scikit-learn",
        "C# / WinUI 3 — .NET 8 · Windows App SDK",
        "Datasets: IoT-23 (Zeek), CICIoT2023",
        "No cloud APIs · No databases · No external services",
        "Fully self-contained on-premises system"
      ]
    },
    {
      "dot": "orange",
      "title": "Offline Training Pipeline",
      "items": [
        "Training: Python scripts under entrenamiento-modelos/",
        "Datasets: IoT-23 (Zeek conn.log), CICIoT2023",
        "Pipeline: load → clean → SMOTE → SelectKBest → XGBoost",
        "Export: exportar_arboles.py → modelo_iot23_arboles.json",
        "IoT-23: 99.87% F1 · 9 features · 9.5M training records",
        "CICIoT2023: 98.06% F1 · 15 features · 7.6M records",
        "Model loads once at inference-server startup"
      ]
    },
    {
      "dot": "slate",
      "title": "Panel Control — Monitoring",
      "items": [
        "WinUI 3 desktop app · .NET 8 · C#",
        "CSV tailing: polls every 500ms",
        "Metrics: reads metricas.json every 10s",
        "Log console: tails servicio.log every 500ms",
        "Buffer: 200 events + 500 log lines",
        "7 metric cards: events, alerts, response time",
        "Threat events highlighted red · filterable"
      ]
    }
  ]
